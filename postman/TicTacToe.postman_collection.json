                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains player games', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.playerName).to.be.a('string');",
                  "    pm.expect(response.totalGames).to.be.a('number');",
                  "    pm.expect(response.games).to.be.an('array');",
                  "});"
                ]

              ]
            },
            "description": "Coordinates range from 0 to 2. Alternate symbol between X and O for subsequent requests."
          }
        }
      ]
    },
    {
      "name": "Players",
      "item": [
        {
          "name": "Get All Players",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains players', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.totalPlayers).to.be.a('number');",

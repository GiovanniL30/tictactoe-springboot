{
  "info": {
    "_postman_id": "0e34e259-c30f-482c-aa49-d6767e38d21c",
    "name": "Tic Tac Toe API",
    "description": "Requests for the Tic Tac Toe REST API. Run Create Game first; it automatically stores roomCode and gameId for the remaining requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "roomCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "gameId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Game",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "pm.collectionVariables.set('roomCode', response.roomCode);",
              "pm.collectionVariables.set('gameId', response.gameId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"playerName\": \"Gio\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/games",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games"
          ]
        },
        "description": "Creates a room with Alice as player X and saves roomCode/gameId as collection variables."
      }
    },
    {
      "name": "Join Game as Second Player",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Participant is player O', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.participant.type).to.eql('PLAYER');",
              "    pm.expect(response.participant.symbol).to.eql('O');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"playerName\": \"Vanni\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{roomCode}}/join",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{roomCode}}",
            "join"
          ]
        }
      }
    },
    {
      "name": "Place Move",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"x\": 0,\n  \"y\": 0,\n  \"symbol\": \"X\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{gameId}}/move",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{gameId}}",
            "move"
          ]
        },
        "description": "Coordinates range from 0 to 2. Alternate symbol between X and O for subsequent requests."
      }
    },
    {
      "name": "Get Game Info",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{roomCode}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{roomCode}}"
          ]
        }
      }
    },
    {
      "name": "Get Board Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{roomCode}}/board",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{roomCode}}",
            "board"
          ]
        }
      }
    },
    {
      "name": "Play Again",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "pm.collectionVariables.set('gameId', response.gameId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{roomCode}}/play-again",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{roomCode}}",
            "play-again"
          ]
        },
        "description": "Starts the next round and replaces the gameId collection variable."
      }
    },
    {
      "name": "History",
      "item": [
        {
          "name": "Get All Room Histories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains history summary', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.totalRooms).to.be.a('number');",
                  "    pm.expect(response.totalGames).to.be.a('number');",
                  "    pm.expect(response.rooms).to.be.an('array');",
                  "    response.rooms.forEach(function (room) {",
                  "        pm.expect(room.roomCode).to.be.a('string');",
                  "        pm.expect(room.games).to.be.an('array');",
                  "        room.games.forEach(function (game) {",
                  "            pm.expect(game).to.have.all.keys('gameId', 'status', 'winner');",
                  "            pm.expect(game).not.to.have.property('roomCode');",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/history/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "history",
                "rooms"
              ]
            }
          }
        },
        {
          "name": "Get Game Moves and Result",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains moves and result', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.moves).to.be.an('array');",
                  "    pm.expect(response.result).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/history/games/{{gameId}}/moves",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "history",
                "games",
                "{{gameId}}",
                "moves"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Delete Room",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.collectionVariables.unset('roomCode');",
              "pm.collectionVariables.unset('gameId');"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{roomCode}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{roomCode}}"
          ]
        }
      }
    }
  ]
}

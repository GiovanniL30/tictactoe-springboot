{
  "info": {
    "_postman_id": "0e34e259-c30f-482c-aa49-d6767e38d21c",
    "name": "Tic Tac Toe API",
    "description": "Requests for the Tic Tac Toe REST API. Run Create Room first; it automatically stores roomCode and gameId for the remaining requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "roomCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "gameId",
      "value": "",
      "type": "string"
    },
    {
      "key": "playerName",
      "value": "Gio",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Get All Rooms",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains room summaries', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.totalRooms).to.be.a('number');",
                  "    pm.expect(response.totalGames).to.be.a('number');",
                  "    pm.expect(response.rooms).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rooms"
              ]
            }
          }
        },
        {
          "name": "Create Room",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('roomCode', response.roomCode);",
                  "pm.collectionVariables.set('gameId', response.gameId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerName\": \"Gio\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rooms"
              ]
            },
            "description": "Creates a room with the requested player as X and saves roomCode/gameId as collection variables."
          }
        },
        {
          "name": "Join Room as Second Player",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Player is player O', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.player.type).to.eql('PLAYER');",
                  "    pm.expect(response.player.symbol).to.eql('O');",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('gameId', response.gameId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerName\": \"Vanni\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/rooms/{{roomCode}}/join",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rooms",
                "{{roomCode}}",
                "join"
              ]
            }
          }
        },
        {
          "name": "Get Room Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rooms/{{roomCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rooms",
                "{{roomCode}}"
              ]
            }
          }
        },
        {
          "name": "Play Again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('gameId', response.gameId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rooms/{{roomCode}}/play-again",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rooms",
                "{{roomCode}}",
                "play-again"
              ]
            },
            "description": "Starts the next round and replaces the gameId collection variable."
          }
        },
        {
          "name": "Delete Room",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.unset('roomCode');",
                  "pm.collectionVariables.unset('gameId');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rooms/{{roomCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rooms",
                "{{roomCode}}"
              ]
            }
          }
        }
      ]
    },
